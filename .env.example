# ── VibeAI environment template ───────────────────────────
# Copy to .env and fill in your own keys. NEVER commit real keys.

# Optional paid manager (leave blank to run the Free Council as primary)
ANTHROPIC_API_KEY=
# Optional second real key for the claude_opus_4_6 model (manual /model selection only)
ANTHROPIC_API_KEY_2=

# ── Free model providers (all no-credit-card signups) ─────
# Groq — https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk_your_key_here
# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# OpenRouter (only :free models are used) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HuggingFace (optional, image generation) — https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
# Web search — Firecrawl (primary, free 1,000 pages/month, no card)
# https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Web search — Exa (semantic search / relevance ranking)
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# OmniRoute (OPTIONAL — a self-hosted local AI gateway you run yourself)
# https://github.com/diegosouzapw/OmniRoute — key from its dashboard's
# Endpoints page. Not started by VibeAI; safe to leave empty.
OMNIROUTE_API_KEY=
# Brave Search (UNUSED — now requires a card even for the free tier)
# https://brave.com/search/api
BRAVE_API_KEY=
# NVIDIA NIM (free, ~40 RPM shared/key, deep fallback only) — https://build.nvidia.com
NVIDIA_API_KEY=
# Z.AI / Zhipu (GLM-4.7-Flash free tier) — https://z.ai/model-api
ZAI_API_KEY=
# Mistral La Plateforme (free "Experiment" tier — ToS: eval/prototype only, NOT
# production traffic; manual /model selection only, not in the auto fallback chain)
# https://console.mistral.ai
MISTRAL_API_KEY=

# ── Optional integrations ──────────────────────────────────
# GitHub PAT (repo + workflow scopes) — https://github.com/settings/tokens
GITHUB_TOKEN=

# Local Ollama (self-hosted models)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── API server ─────────────────────────────────────────────
# SECURITY: keep 127.0.0.1 unless you put the server behind a reverse proxy
# you control. The API can create files and run shell commands.
API_HOST=127.0.0.1
API_PORT=8000
# Bearer token required on all mutating API routes when set.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
VIBE_API_TOKEN=

# ── System settings ────────────────────────────────────────
LOG_LEVEL=INFO
MAX_REVIEW_ITERATIONS=3
QUALITY_THRESHOLD=0.85
SESSION_DB_PATH=./logs/sessions.db

# ── Capability Hub ────────────────────────────────────────────────────────────
# Production must use an async PostgreSQL URL. SQLite is local/test only.
CAPABILITY_DATABASE_URL=sqlite+aiosqlite:///./logs/capabilities.db
DEPLOYMENT_ENVIRONMENT=local
CAPABILITY_HUB_ENABLED=true
# Keep external mutations off until PostgreSQL, Clerk verification, the GitHub
# App, and the versioned credential key are configured and the release gate passes.
CAPABILITY_ACTIONS_ENABLED=false
CAPABILITY_CREDENTIAL_KEYS=
CAPABILITY_CREDENTIAL_ACTIVE_KEY=v1
CAPABILITY_QUARANTINE_PATH=./logs/capability-quarantine
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CAPABILITY_BOOTSTRAP_ADMIN_IDS=
CAPABILITY_BOOTSTRAP_REVIEWER_IDS=
GITHUB_APP_SLUG=
GITHUB_APP_STATE_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=https://vibeai-showcase.vercel.app/?capability_callback=github

# ── VibeMind (desktop assistant, vibemind/) ─────────────────
# Spotify: free app at https://developer.spotify.com/dashboard -> "Create app"
# (any name/redirect URI works -- this only uses Client Credentials auth,
# no OAuth redirect ever happens). Without these, "play X on Spotify" still
# works but just opens search results instead of playing the exact track.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
